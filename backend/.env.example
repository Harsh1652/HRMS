# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# From Project Settings > Database > Connection string.
#
# Pooled connection (transaction mode, port 6543), used by the app.
#   pgbouncer=true       required for the pooler (disables prepared statements).
#   connection_limit=15  the default pool is too small for a remote pooler and runs out (P2024).
#   pool_timeout=30      seconds to wait for a free connection (default 10).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15&pool_timeout=30"
#
# Direct connection (port 5432), used by `prisma migrate` and `prisma db push`.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# At least 32 characters. To generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-value-at-least-32-chars"
JWT_EXPIRES_IN=30m

# Comma-separated allowed origins (defaults to the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
