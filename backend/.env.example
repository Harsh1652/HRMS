# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# --- Supabase (used ONLY as hosted PostgreSQL — no Supabase Auth / RLS / supabase-js) ---
# Supabase dashboard → Project Settings → Database → Connection string.
#
# Pooled connection (Transaction mode, port 6543). Used by the running app.
#   pgbouncer=true       Prisma disables prepared statements (required for the pooler).
#   connection_limit=15  Prisma's own pool size. Default is CPUs*2+1 (=9 here); each
#                        request to a remote pooler holds a slot for 2-7 s, so a few
#                        concurrent pages exhaust 9 and later requests fail with P2024.
#   pool_timeout=30      Seconds a request waits for a free slot before failing (default 10).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15&pool_timeout=30"
#
# Direct connection (port 5432). Used by `prisma migrate` and `prisma db push`.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth ---
# At least 32 chars. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-value-at-least-32-chars"
JWT_EXPIRES_IN=30m

# --- HTTP ---
# Comma-separated list of allowed browser origins (Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
