# Copy to .env.test. Jest loads it instead of .env.
#
# `schema=test` keeps the test reset and seed away from the real `public` schema.
# Both URLs use the direct connection (port 5432): the pooler rejects the
# search_path option Prisma needs for `schema=`.

NODE_ENV=test
PORT=4001

DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=test"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=test"

# Any value of 32+ characters.
JWT_SECRET="test-secret-test-secret-test-secret-test-secret"
JWT_EXPIRES_IN=30m

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=silent
