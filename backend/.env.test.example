# Copy to .env.test. Loaded by Jest (tests/setup/loadEnv.ts) instead of .env.
#
# Same Supabase project as .env, but every URL carries `schema=test` so the
# test run's `prisma db push --force-reset` and seed never touch the real
# `public` schema. Prisma creates the `test` schema on first push.
#
# BOTH URLs use the DIRECT connection (port 5432) here — not the pooler.
# Supabase's pooler (Supavisor, transaction mode) rejects the search_path
# startup option Prisma uses to implement `schema=`, so a pooled URL with
# `schema=test` fails with "Can't reach database server". Tests do not need
# pooling. See docs/DECISIONS.md D-016.

NODE_ENV=test
PORT=4001

DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=test"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=test"

# Any 32+ char value; tests sign their own tokens with it.
JWT_SECRET="test-secret-test-secret-test-secret-test-secret"
JWT_EXPIRES_IN=30m

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=silent
